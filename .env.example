# ChurchTools Configuration
CT_BASE_URL=https://yourchurchtoolsinstance.church.tools
CT_LOGIN_TOKEN=your_login_token

# Nextcloud Configuration
NC_BASE_URL=https://yournextcloudinstance.com
NC_USERNAME=your_nextcloud_username
NC_PASSWORD=your_nextcloud_password
NC_GROUP_PREFIX=ChurchTools-

# Claim Type: 'groups' (default) or 'roles'
# - groups: <Prefix><GroupName> (e.g. ChurchTools-Leadership)
# - roles:  <Prefix><GroupName>_<RoleName> (e.g. ChurchTools-Leadership_Leader)
NC_GROUPS_CLAIM=groups

# Sync Options
# DRY_RUN: true (preview only, no modifications) or false (apply changes to Nextcloud)
DRY_RUN=true

# Remove groups with NC_GROUP_PREFIX from users if they are no longer members in ChurchTools
REMOVE_EXTRA_GROUPS=true

# Logging Options
LOG_LEVEL=INFO
# Console log format: 'simple' (clean CLI output without timestamps), 'detailed', 'compact', 'plain', or custom string
LOG_FORMAT=simple
# Optional: Set a file path to enable rotating file logs (default: console only)
# LOG_FILE=logs/sync.log
# LOG_ROTATION=10 MB
# LOG_RETENTION=30 days
